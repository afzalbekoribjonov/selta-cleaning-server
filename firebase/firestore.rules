rules_version = '2';

// Selta Cleaning — Firestore xavfsizlik qoidalari (Faza 1 qoralamasi)
//
// Asosiy tamoyil (reja: "Muhim dizayn qarorlari" #3-4): status o'tishlari,
// xodim yaratish/PIN o'zgartirish/ishdan bo'shatish va boshqa nozik
// operatsiyalar HECH QACHON to'g'ridan-to'g'ri klient yozuvi orqali emas,
// balki Cloud Functions callable orqali amalga oshadi — Admin SDK qoidalarni
// chetlab o'tadi, shuning uchun bu yerda faqat "past xavfli" yozuvlar
// (izohlar) va o'qish ruxsatlari belgilanadi.
//
// Custom claims (loginWithPin / admin auth orqali token'ga yoziladi):
//   role: 'dispatcher' | 'worker' | 'delivery' | 'qc' | 'admin'
//   employeeId: string
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function employeeId() {
      return request.auth.token.employeeId;
    }

    // --- employees -----------------------------------------------------
    // Xodimning o'zi asosiy profilini o'qishi, admin esa barchasini
    // o'qishi mumkin. PIN xesh maydoni bu hujjatda umuman saqlanmaydi —
    // alohida `private/credentials` subhujjatida, u yerga hech qanday
    // klient (admin ham) o'qish/yozish huquqiga ega emas (faqat Admin SDK).
    match /employees/{employeeId} {
      allow read: if isAdmin() || (isSignedIn() && employeeId() == employeeId);
      allow write: if false; // faqat Cloud Functions (adminCreateEmployee va h.k.)

      match /private/{doc=**} {
        allow read, write: if false;
      }

      match /payrollRuns/{yyyyMM} {
        allow read: if isAdmin() || (isSignedIn() && employeeId() == employeeId);
        allow write: if false; // faqat scheduled/callable Cloud Function
      }

      match /departmentHistory/{eventId} {
        allow read: if isAdmin();
        allow write: if false; // faqat adminChangeEmployeeDepartment (Admin SDK)
      }
    }

    // Yuqoridagi ichma-ich qoida faqat aniq xodim yo'li bo'yicha
    // to'g'ridan-to'g'ri so'rovlarga tegishli. "Oylik hisobot" sahifasi
    // BARCHA xodimlarning payrollRuns'ini bitta collection-group so'rovda
    // o'qiydi — bunday so'rovlar uchun Firestore alohida `{path=**}`
    // qoidasini talab qiladi (oddiy ichma-ich qoida uni qamrab olmaydi).
    match /{path=**}/payrollRuns/{yyyyMM} {
      allow read: if isAdmin();
    }

    // --- orders ----------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow write: if false; // yaratish/holat o'zgarishi faqat callable orqali

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow write: if false; // QC pass/fail, o'lchov kiritish — callable orqali
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        // Izoh — past xavfli, to'g'ridan-to'g'ri klient yozuviga ruxsat
        // beriladi, lekin faqat o'z nomidan.
        allow create: if isSignedIn()
          && request.resource.data.authorId == employeeId()
          && request.resource.data.createdAt == request.time;
        // Muallif o'z izohini tahrirlashi mumkin — faqat matn va
        // `editedAt` o'zgaradi, muallif/yaratilgan vaqt o'zgarmasdir
        // (audit ishonchliligi saqlanadi).
        allow update: if isSignedIn()
          && resource.data.authorId == employeeId()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.editedAt == request.time;
        allow delete: if false;
      }

      match /statusHistory/{eventId} {
        allow read: if isSignedIn();
        allow write: if false; // faqat Cloud Function trigger yozadi
      }
    }

    // --- products / settings / counters ---------------------------------
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /counters/{doc} {
      allow read, write: if false; // faqat createOrder tranzaksiyasi (Admin SDK)
    }

    // --- expenses ---------------------------------------------------------
    // Moliyaviy ma'lumot — faqat admin ko'radi va yozadi (xodimlar buni
    // umuman ko'rmaydi). Yozish baribir server orqali, boshqa yozuvlar bilan
    // bir xil izchillik uchun.
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- customDepartments --------------------------------------------------
    // "Boshqa" tanlanganda admin kiritgan yangi kasblar reestri (label +
    // statistikaga qo'shish/qo'shmaslik belgisi). Yozish baribir server
    // orqali (adminCreateEmployee/adminChangeEmployeeDepartment).
    match /customDepartments/{departmentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}

# admin_web/.env.local bilan bir xil Firebase loyihasi — shu qiymatlarni
# u yerdan nusxalab, faylni .env.local nomi bilan saqlang (.gitignore'da,
# hech qachon commit qilinmasin).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# server/ (Render'dagi Express backend) manzili
VITE_SERVER_BASE_URL=

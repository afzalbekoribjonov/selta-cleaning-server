{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "selta_mobile_web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd mobile && flutter run -d web-server --web-port 5678 --web-hostname 127.0.0.1 --dart-define=SERVER_BASE_URL=https://selta-cleaning-server.onrender.com"],
      "port": 5678,
      "url": "http://127.0.0.1:5678"
    },
    {
      "name": "selta_admin_web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd admin_web && npm run dev -- --port 5679 --host 127.0.0.1"],
      "port": 5679,
      "url": "http://127.0.0.1:5679"
    }
  ]
}

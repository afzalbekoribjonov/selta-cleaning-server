# Lokal ishga tushirish uchun (Render'da bu qiymat dashboard'da qo'lda
# kiritiladi, gitga hech qachon qo'shilmaydi):
#   Firebase Console -> Project settings -> Service accounts ->
#   "Generate new private key" -> yuklab olingan JSON faylning TO'LIQ
#   matnini (bitta qatorga siqib) shu yerga qo'ying.
FIREBASE_SERVICE_ACCOUNT=

# Ixtiyoriy — Render o'zi avtomatik beradi, lokal uchun standart 8080.
PORT=8080

# Ixtiyoriy — kunlik hisobot Telegram boti (BotFather tokeni). Berilmasa bot
# o'chiq. Webhook manzili Render'ning RENDER_EXTERNAL_URL qiymatidan olinadi;
# boshqa joyda ishlatilsa TELEGRAM_WEBHOOK_BASE_URL=https://... beriladi.
TELEGRAM_BOT_TOKEN=
